# Copy to landing/.env.local (gitignored). Baked into the static export at `npm run build` — none of
# these is a secret: a Firebase web config is public by design, and the runner key here is the PUBLIC
# half of `python -m runner.keygen`. Local dev uses the Emulator Suite with a demo-* project id.
NEXT_PUBLIC_USE_EMULATORS=1
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-hisab
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-hisab.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RUNNER_PUBLIC_KEY=
