# secrets
.env
*.token

# runtime state (per install, never shared)
data/
*.jsonl
offset
session_id
__pycache__/
*.pyc
.venv/

# a user's real ledger, if someone mounts it inside the repo
vault/
ledger/
daily/_done/

# os / editor
.DS_Store
.idea/
.vscode/

# local config and scratch
config.yaml
config-*.yaml
scratch-*/

# runner (hosted mode): per-tenant vault/data/config, dev-profile service account
runner-data/
service-account*.json

# firebase emulator logs and the rules test's dependencies
firebase-debug.log
firestore-debug.log
ui-debug.log
tests/rules/node_modules/

# landing build output
landing/node_modules/
landing/.next/
landing/out/
landing/.env*.local
.firebaserc

# misc
NOTES.md
.playwright-mcp/

# Obsidian config when a ledger folder is opened as a vault
.obsidian/

# third-party documents never belong here
*.pdf

# landing dev server
.landing-server.pid
.landing-server.log

# hosted-mode background emulators (make up / make emulators-up)
.emulators.pid

# source font for landing/assets/noori-nastaleeq.woff2 (13 MB); only the subset is committed
landing/assets/*.ttf
