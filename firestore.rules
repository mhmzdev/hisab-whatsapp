rules_version = '2';
// Deny-by-default: the runner reads/writes tenants with the privileged Admin SDK, which bypasses
// these rules entirely. #7 replaces this with owner-scoped rules for the portal's client writes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
