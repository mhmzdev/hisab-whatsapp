# Copy to .env and fill in. Both are secrets; .env is gitignored.

# WhatsApp → Settings → Agents → your agent → Chat info → API key
WHATSAPP_TOKEN=

# https://openrouter.ai/keys — one key covers the model and voice transcription
OPENROUTER_API_KEY=

# Only if you use examples/config.gemini.yaml
GEMINI_API_KEY=

# Runner only (hosted mode) — generate with: python -m runner.keygen
RUNNER_PRIVATE_KEY=

# Hosted mode — the portal build (landing/.env.local, see landing/.env.example). Names only, never values.
# NEXT_PUBLIC_FIREBASE_PROJECT_ID, NEXT_PUBLIC_FIREBASE_API_KEY, NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN,
# NEXT_PUBLIC_FIREBASE_APP_ID — the Firebase web config (public by design)
# NEXT_PUBLIC_RUNNER_PUBLIC_KEY   — the PUBLIC half of `python -m runner.keygen`, safe to embed
# NEXT_PUBLIC_USE_EMULATORS=1     — point the portal at the local Emulator Suite (firebase.json ports)
# FIRESTORE_EMULATOR_HOST         — runner only, local profile: host.docker.internal:8080 (set by `make runner-up`)
