# Copy to .env and fill in. Both are secrets; .env is gitignored.

# WhatsApp → Settings → Agents → your agent → Chat info → API key
WHATSAPP_TOKEN=

# https://openrouter.ai/keys — one key covers the model and voice transcription
OPENROUTER_API_KEY=

# Only if you use examples/config.openai.yaml (OpenAI directly) or examples/config.gemini.yaml
OPENAI_API_KEY=
GEMINI_API_KEY=
